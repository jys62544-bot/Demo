# Empty uses same-origin /api. In local Vite dev, vite.config.ts proxies /api and /uploads to Wrangler at 127.0.0.1:8787.
# For deployed Cloudflare Pages, set this to the Worker URL, for example:
# VITE_API_BASE_URL=https://industrial-demo-api.<your-subdomain>.workers.dev
VITE_API_BASE_URL=
VITE_USE_MOCK=false
