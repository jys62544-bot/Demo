{
  "name": "industrial-demo-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "d1:create": "wrangler d1 create industrial-demo-db",
    "d1:migrate:local": "wrangler d1 migrations apply industrial-demo-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply industrial-demo-db --remote",
    "r2:create": "wrangler r2 bucket create industrial-demo-uploads"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
